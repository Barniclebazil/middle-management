  "smallTalk": [
    [
      "Whose round is it?",
      "Yours. It has been yours since Tuesday."
    ],
    [
      "What's the forecast?",
      "Sunny spells, heavy showers, and a concrete pour booked for both."
    ],
    [
      "Has the steel turned up yet?",
      "It's on the motorway. It is always on the motorway."
    ],
    [
      "Who's got my tape measure?",
      "Everyone has got a tape measure. Nobody has got yours."
    ],
    [
      "Is the crane running today?",
      "Too windy. It's having a lie-in."
    ],
    [
      "Have you seen the new drawings?",
      "Revision F. Same as E, but the door has moved again."
    ],
    [
      "Why are your boots so clean?",
      "I've been in the cabin doing timesheets all week."
    ],
    [
      "Did you sign the permit?",
      "I signed the permit to sign the permit."
    ]
  ],
