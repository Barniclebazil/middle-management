        "facialHair": "#9fe82e",
        "pants": "#4a4f6a",
        "shoes": "#191622",
        "glasses": "#ff7a1f"
      },
      "lines": [
        "The firewall blocked lunch again. It thinks noodles are a threat.",
        "Someone set their password to 'rain'. Bold, given the weather.",
        "I patched the thing. Then the thing patched me back."
      ]
    },
    {
      "name": "Mei-Lin Varga",
      "role": "Synth-Noodle Chef",
      "look": {
        "head": "receptionist",
        "skin": "fair",
        "build": "normal",
        "outfit": "plain",
        "hair": "#ff4fd8",
        "hairHighlight": "#ffaaee",
