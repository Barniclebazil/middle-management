  "manager": {
    "name": "Selwyn Okafor-Lind",
    "look": {
      "head": "boss",
      "skin": "deep",
      "build": "tall",
      "outfit": "suit",
      "hair": "#e4e2f2",
      "hairHighlight": "#ffffff",
      "eye": "#3ff0ff",
      "shirt": "#1c1630",
      "outer": "#dcd8ec",
      "sleeve": "#dcd8ec",
      "tie": "#ff2fa8",
      "collar": "#2a2244",
      "pants": "#cfcae2",
      "shoes": "#241c36",
      "belt": true,
      "beltColor": "#3ff0ff"
    },
    "lines": [
      "Let's lock this in before the downpour, so about now.",
      "My door is always open. It is also biometric, so knock first.",
      "Great quarter, everyone. The bonus is a slightly bigger umbrella.",
      "I asked the board for more budget. They sent a motivational hologram.",
      "Can the deliverable glow a bit more? Investors love a glow.",
      "We are a family here. A family with a very long contract."
    ]
  },
  "receptionist": {
    "name": "Tamsin Revell",
    "look": {
      "head": "headset",
      "skin": "fair",
      "build": "normal",
      "outfit": "blouse",
      "hair": "#2fe8ff",
