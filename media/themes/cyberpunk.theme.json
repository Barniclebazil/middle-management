  "smallTalk": [
    [
      "Is it still raining?",
      "Forecast says yes until further notice. Further notice is also rain."
    ],
    [
      "Did the lift try to sell you something this morning?",
      "Heated socks. It knew my shoe size, which I did not enjoy."
    ],
    [
      "My arm wants another firmware update.",
      "Do not accept. Last time my elbow moved to a premium tier."
    ],
    [
      "The vending machine said it was disappointed in me.",
      "It does that. Buy the seaweed crisps and it warms up again."
    ],
    [
      "How strong is the coffee today?",
      "Overclocked. I can hear colours, and my stapler seems very slow."
    ],
    [
      "Did you read the latest wellness memo?",
      "Yes. Compulsory joy is at three, in the holo-briefing room."
    ],
    [
      "The sign out front is flickering again.",
      "Maintenance says it is Morse code. So far it has spelt 'lunch'."
    ],
    [
      "Who left a drone charging in the noodle bar?",
      "It is mine. It likes the steam. Please do not feed it broth."
    ]
  ],
  "staff": [
    {
      "name": "Ravi Underhill",
      "role": "Data Broker",
      "look": {
        "head": "crossword",
        "skin": "brown",
        "build": "big",
