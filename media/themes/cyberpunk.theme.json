        "shortSleeves": true
      },
      "lines": [
        "Parcel for floor 212. The drone wants a signature and a compliment.",
        "I delivered in the rain again. The drone wants hazard pay in batteries.",
        "Do not wave at drones. They think you want a subscription."
      ]
    },
    {
      "name": "Fen Okoro",
      "role": "Firewall Technician",
