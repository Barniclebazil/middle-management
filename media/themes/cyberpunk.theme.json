        "collar": "#ff2fa8",
        "pants": "#3c3a5e",
        "shoes": "#d6dc3a",
        "belt": true,
        "beltColor": "#ff2fa8",
        "shortSleeves": true
      },
      "lines": [
        "Today's special is noodles. Yesterday's special was also noodles.",
        "The broth is synthetic, but the effort is entirely real.",
        "Extra spicy comes with a waiver. Please sign it at the counter."
      ]
    },
    {
      "name": "Gideon Marlow",
      "role": "Chrome Fitter",
      "look": {
        "head": "chili",
        "skin": "warm",
        "build": "big",
        "outfit": "openCardigan",
        "hair": "#c8ccd8",
        "hairHighlight": "#ffffff",
