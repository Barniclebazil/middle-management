        "outer": "#8a90a8",
        "sleeve": "#b4bacc",
        "collar": "#e6faff",
        "pants": "#53586e",
        "shoes": "#20202a",
        "glasses": "#ff2fa8"
      },
      "lines": [
        "Your new arm is ready. It has a cup holder, as requested.",
        "No knuckle lights in meetings, please. It is distracting.",
        "Chrome needs polishing every week. Feelings, every fortnight."
      ]
    },
    {
      "name": "Saoirse Delacroix",
      "role": "Rain-Forecast Analyst",
      "look": {
        "head": "assistant",
        "skin": "olive",
